<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.pms.mapper.PmsSkuMapper">

    <resultMap type="com.ruoyi.system.pms.domain.PmsSku" id="PmsSkuResult">
        <id     property="skuId"              column="sku_id"              />
        <result property="bareboneId"         column="barebone_id"         />
        <result property="skuCode"            column="sku_code"            />
        <result property="configDescription"  column="config_description"  />
        <result property="totalAddPriceUsd"   column="total_add_price_usd" />
        <result property="status"             column="status"              />
        <result property="createBy"           column="create_by"           />
        <result property="createTime"         column="create_time"         />
        <result property="updateBy"           column="update_by"           />
        <result property="updateTime"         column="update_time"         />
        <result property="remark"             column="remark"              />
        <result property="modelName"          column="model_name"          />
        <result property="supplierId"         column="supplier_id"         />
        <result property="supplierName"       column="supplier_name"       />
    </resultMap>

    <sql id="selectSkuVo">
        select s.sku_id, s.barebone_id, s.sku_code, s.config_description, s.total_add_price_usd, s.status, s.create_by, s.create_time, s.update_by, s.update_time, s.remark,
               b.model_name, b.supplier_id, sp.supplier_name
        from pms_sku s
        left join pms_barebone b on s.barebone_id = b.barebone_id
        left join pms_supplier sp on b.supplier_id = sp.supplier_id
    </sql>

    <select id="selectSkuById" parameterType="Long" resultMap="PmsSkuResult">
        <include refid="selectSkuVo"/>
        where s.sku_id = #{skuId}
    </select>

    <select id="selectSkuList" parameterType="com.ruoyi.system.pms.domain.PmsSku" resultMap="PmsSkuResult">
        <include refid="selectSkuVo"/>
        <where>
            <if test="bareboneId != null">
                AND s.barebone_id = #{bareboneId}
            </if>
            <if test="skuCode != null and skuCode != ''">
                AND s.sku_code like concat('%', #{skuCode}, '%')
            </if>
            <if test="configDescription != null and configDescription != ''">
                AND s.config_description like concat('%', #{configDescription}, '%')
            </if>
            <if test="status != null and status != ''">
                AND s.status = #{status}
            </if>
            <if test="supplierId != null">
                AND b.supplier_id = #{supplierId}
            </if>
        </where>
        order by s.create_time desc
    </select>

    <select id="checkSkuCodeUnique" parameterType="String" resultMap="PmsSkuResult">
        select sku_id, sku_code from pms_sku where sku_code = #{skuCode} limit 1
    </select>

    <insert id="insertSku" parameterType="com.ruoyi.system.pms.domain.PmsSku" useGeneratedKeys="true" keyProperty="skuId">
        insert into pms_sku (
            <if test="bareboneId != null">barebone_id,</if>
            <if test="skuCode != null and skuCode != ''">sku_code,</if>
            <if test="configDescription != null and configDescription != ''">config_description,</if>
            <if test="totalAddPriceUsd != null">total_add_price_usd,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        ) values (
            <if test="bareboneId != null">#{bareboneId},</if>
            <if test="skuCode != null and skuCode != ''">#{skuCode},</if>
            <if test="configDescription != null and configDescription != ''">#{configDescription},</if>
            <if test="totalAddPriceUsd != null">#{totalAddPriceUsd},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateSku" parameterType="com.ruoyi.system.pms.domain.PmsSku">
        update pms_sku
        <set>
            <if test="bareboneId != null">barebone_id = #{bareboneId},</if>
            <if test="skuCode != null and skuCode != ''">sku_code = #{skuCode},</if>
            <if test="configDescription != null and configDescription != ''">config_description = #{configDescription},</if>
            <if test="totalAddPriceUsd != null">total_add_price_usd = #{totalAddPriceUsd},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where sku_id = #{skuId}
    </update>

    <delete id="deleteSkuById" parameterType="Long">
        delete from pms_sku where sku_id = #{skuId}
    </delete>

    <delete id="deleteSkuByIds" parameterType="Long">
        delete from pms_sku where sku_id in
        <foreach item="skuId" collection="array" open="(" separator="," close=")">
            #{skuId}
        </foreach>
    </delete>

</mapper>