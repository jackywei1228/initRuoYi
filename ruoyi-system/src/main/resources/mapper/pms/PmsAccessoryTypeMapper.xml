<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.pms.mapper.PmsAccessoryTypeMapper">

    <resultMap type="com.ruoyi.system.pms.domain.PmsAccessoryType" id="PmsAccessoryTypeResult">
        <id     property="typeId"       column="type_id"        />
        <result property="typeName"     column="type_name"      />
        <result property="typeCode"     column="type_code"      />
        <result property="sortOrder"    column="sort_order"     />
        <result property="isSystem"     column="is_system"      />
        <result property="status"       column="status"         />
        <result property="createBy"     column="create_by"      />
        <result property="createTime"   column="create_time"    />
        <result property="updateBy"     column="update_by"      />
        <result property="updateTime"   column="update_time"    />
    </resultMap>

    <sql id="selectAccessoryTypeVo">
        select type_id, type_name, type_code, sort_order, is_system, status, create_by, create_time, update_by, update_time
        from pms_accessory_type
    </sql>

    <select id="selectAccessoryTypeById" parameterType="Long" resultMap="PmsAccessoryTypeResult">
        <include refid="selectAccessoryTypeVo"/>
        where type_id = #{typeId}
    </select>

    <select id="selectAccessoryTypeList" parameterType="com.ruoyi.system.pms.domain.PmsAccessoryType" resultMap="PmsAccessoryTypeResult">
        <include refid="selectAccessoryTypeVo"/>
        <where>
            <if test="typeName != null and typeName != ''">
                AND type_name like concat('%', #{typeName}, '%')
            </if>
            <if test="typeCode != null and typeCode != ''">
                AND type_code like concat('%', #{typeCode}, '%')
            </if>
            <if test="isSystem != null and isSystem != ''">
                AND is_system = #{isSystem}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by sort_order, create_time desc
    </select>

    <select id="checkTypeCodeUnique" parameterType="String" resultMap="PmsAccessoryTypeResult">
        <include refid="selectAccessoryTypeVo"/>
        where type_code = #{typeCode} limit 1
    </select>

    <insert id="insertAccessoryType" parameterType="com.ruoyi.system.pms.domain.PmsAccessoryType" useGeneratedKeys="true" keyProperty="typeId">
        insert into pms_accessory_type (
            <if test="typeName != null and typeName != ''">type_name,</if>
            <if test="typeCode != null and typeCode != ''">type_code,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="isSystem != null and isSystem != ''">is_system,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        ) values (
            <if test="typeName != null and typeName != ''">#{typeName},</if>
            <if test="typeCode != null and typeCode != ''">#{typeCode},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="isSystem != null and isSystem != ''">#{isSystem},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateAccessoryType" parameterType="com.ruoyi.system.pms.domain.PmsAccessoryType">
        update pms_accessory_type
        <set>
            <if test="typeName != null and typeName != ''">type_name = #{typeName},</if>
            <if test="typeCode != null and typeCode != ''">type_code = #{typeCode},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="isSystem != null and isSystem != ''">is_system = #{isSystem},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where type_id = #{typeId}
    </update>

    <delete id="deleteAccessoryTypeById" parameterType="Long">
        delete from pms_accessory_type where type_id = #{typeId}
    </delete>

    <delete id="deleteAccessoryTypeByIds" parameterType="Long">
        delete from pms_accessory_type where type_id in
        <foreach item="typeId" collection="array" open="(" separator="," close=")">
            #{typeId}
        </foreach>
    </delete>

</mapper>