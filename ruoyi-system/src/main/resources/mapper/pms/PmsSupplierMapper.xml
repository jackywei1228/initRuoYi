<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.pms.mapper.PmsSupplierMapper">

    <resultMap type="com.ruoyi.system.pms.domain.PmsSupplier" id="PmsSupplierResult">
        <id     property="supplierId"     column="supplier_id"      />
        <result property="supplierName"   column="supplier_name"    />
        <result property="contactName"    column="contact_name"     />
        <result property="contactPhone"   column="contact_phone"    />
        <result property="contactEmail"   column="contact_email"    />
        <result property="address"        column="address"          />
        <result property="leadCycleDays"  column="lead_cycle_days"  />
        <result property="status"         column="status"           />
        <result property="createBy"       column="create_by"        />
        <result property="createTime"     column="create_time"      />
        <result property="updateBy"       column="update_by"        />
        <result property="updateTime"     column="update_time"      />
        <result property="remark"         column="remark"           />
    </resultMap>

    <sql id="selectSupplierVo">
        select supplier_id, supplier_name, contact_name, contact_phone, contact_email, address, lead_cycle_days, status, create_by, create_time, update_by, update_time, remark
        from pms_supplier
    </sql>

    <select id="selectSupplierById" parameterType="Long" resultMap="PmsSupplierResult">
        <include refid="selectSupplierVo"/>
        where supplier_id = #{supplierId}
    </select>

    <select id="selectSupplierList" parameterType="com.ruoyi.system.pms.domain.PmsSupplier" resultMap="PmsSupplierResult">
        <include refid="selectSupplierVo"/>
        <where>
            <if test="supplierName != null and supplierName != ''">
                AND supplier_name like concat('%', #{supplierName}, '%')
            </if>
            <if test="contactName != null and contactName != ''">
                AND contact_name like concat('%', #{contactName}, '%')
            </if>
            <if test="contactPhone != null and contactPhone != ''">
                AND contact_phone like concat('%', #{contactPhone}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="checkSupplierNameUnique" parameterType="String" resultMap="PmsSupplierResult">
        <include refid="selectSupplierVo"/>
        where supplier_name = #{supplierName} limit 1
    </select>

    <insert id="insertSupplier" parameterType="com.ruoyi.system.pms.domain.PmsSupplier" useGeneratedKeys="true" keyProperty="supplierId">
        insert into pms_supplier (
            <if test="supplierName != null and supplierName != ''">supplier_name,</if>
            <if test="contactName != null and contactName != ''">contact_name,</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone,</if>
            <if test="contactEmail != null and contactEmail != ''">contact_email,</if>
            <if test="address != null and address != ''">address,</if>
            <if test="leadCycleDays != null">lead_cycle_days,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        ) values (
            <if test="supplierName != null and supplierName != ''">#{supplierName},</if>
            <if test="contactName != null and contactName != ''">#{contactName},</if>
            <if test="contactPhone != null and contactPhone != ''">#{contactPhone},</if>
            <if test="contactEmail != null and contactEmail != ''">#{contactEmail},</if>
            <if test="address != null and address != ''">#{address},</if>
            <if test="leadCycleDays != null">#{leadCycleDays},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateSupplier" parameterType="com.ruoyi.system.pms.domain.PmsSupplier">
        update pms_supplier
        <set>
            <if test="supplierName != null and supplierName != ''">supplier_name = #{supplierName},</if>
            <if test="contactName != null">contact_name = #{contactName},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="contactEmail != null">contact_email = #{contactEmail},</if>
            <if test="address != null">address = #{address},</if>
            <if test="leadCycleDays != null">lead_cycle_days = #{leadCycleDays},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where supplier_id = #{supplierId}
    </update>

    <delete id="deleteSupplierById" parameterType="Long">
        delete from pms_supplier where supplier_id = #{supplierId}
    </delete>

    <delete id="deleteSupplierByIds" parameterType="Long">
        delete from pms_supplier where supplier_id in
        <foreach item="supplierId" collection="array" open="(" separator="," close=")">
            #{supplierId}
        </foreach>
    </delete>

</mapper>