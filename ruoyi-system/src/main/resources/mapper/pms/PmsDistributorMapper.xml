<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.pms.mapper.PmsDistributorMapper">

    <resultMap type="com.ruoyi.system.pms.domain.PmsDistributor" id="PmsDistributorResult">
        <id     property="distributorId"    column="distributor_id"    />
        <result property="userId"           column="user_id"           />
        <result property="levelId"          column="level_id"          />
        <result property="companyName"      column="company_name"      />
        <result property="contactName"      column="contact_name"      />
        <result property="contactPhone"     column="contact_phone"     />
        <result property="contactEmail"     column="contact_email"     />
        <result property="address"          column="address"           />
        <result property="creditLimit"      column="credit_limit"      />
        <result property="status"           column="status"            />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="remark"           column="remark"            />
        <result property="userName"         column="user_name"         />
        <result property="levelName"        column="level_name"        />
    </resultMap>

    <sql id="selectDistributorVo">
        select d.distributor_id, d.user_id, d.level_id, d.company_name, d.contact_name, d.contact_phone, d.contact_email, d.address, d.credit_limit, d.status, d.create_by, d.create_time, d.update_by, d.update_time, d.remark,
               u.user_name, dl.level_name
        from pms_distributor d
        left join sys_user u on d.user_id = u.user_id
        left join pms_distributor_level dl on d.level_id = dl.level_id
    </sql>

    <select id="selectDistributorById" parameterType="Long" resultMap="PmsDistributorResult">
        <include refid="selectDistributorVo"/>
        where d.distributor_id = #{distributorId}
    </select>

    <select id="selectDistributorList" parameterType="com.ruoyi.system.pms.domain.PmsDistributor" resultMap="PmsDistributorResult">
        <include refid="selectDistributorVo"/>
        <where>
            <if test="userId != null">
                AND d.user_id = #{userId}
            </if>
            <if test="levelId != null">
                AND d.level_id = #{levelId}
            </if>
            <if test="companyName != null and companyName != ''">
                AND d.company_name like concat('%', #{companyName}, '%')
            </if>
            <if test="contactName != null and contactName != ''">
                AND d.contact_name like concat('%', #{contactName}, '%')
            </if>
            <if test="contactPhone != null and contactPhone != ''">
                AND d.contact_phone like concat('%', #{contactPhone}, '%')
            </if>
            <if test="status != null and status != ''">
                AND d.status = #{status}
            </if>
        </where>
        order by d.create_time desc
    </select>

    <select id="selectByLevelId" parameterType="Long" resultMap="PmsDistributorResult">
        <include refid="selectDistributorVo"/>
        where d.level_id = #{levelId}
        order by d.create_time desc
    </select>

    <select id="selectDistributorByUserId" parameterType="Long" resultMap="PmsDistributorResult">
        <include refid="selectDistributorVo"/>
        where d.user_id = #{userId}
    </select>

    <select id="checkCompanyNameUnique" parameterType="String" resultMap="PmsDistributorResult">
        select distributor_id, company_name from pms_distributor where company_name = #{companyName} limit 1
    </select>

    <insert id="insertDistributor" parameterType="com.ruoyi.system.pms.domain.PmsDistributor" useGeneratedKeys="true" keyProperty="distributorId">
        insert into pms_distributor (
            <if test="userId != null">user_id,</if>
            <if test="levelId != null">level_id,</if>
            <if test="companyName != null and companyName != ''">company_name,</if>
            <if test="contactName != null and contactName != ''">contact_name,</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone,</if>
            <if test="contactEmail != null and contactEmail != ''">contact_email,</if>
            <if test="address != null and address != ''">address,</if>
            <if test="creditLimit != null">credit_limit,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        ) values (
            <if test="userId != null">#{userId},</if>
            <if test="levelId != null">#{levelId},</if>
            <if test="companyName != null and companyName != ''">#{companyName},</if>
            <if test="contactName != null and contactName != ''">#{contactName},</if>
            <if test="contactPhone != null and contactPhone != ''">#{contactPhone},</if>
            <if test="contactEmail != null and contactEmail != ''">#{contactEmail},</if>
            <if test="address != null and address != ''">#{address},</if>
            <if test="creditLimit != null">#{creditLimit},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateDistributor" parameterType="com.ruoyi.system.pms.domain.PmsDistributor">
        update pms_distributor
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="levelId != null">level_id = #{levelId},</if>
            <if test="companyName != null and companyName != ''">company_name = #{companyName},</if>
            <if test="contactName != null">contact_name = #{contactName},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="contactEmail != null">contact_email = #{contactEmail},</if>
            <if test="address != null">address = #{address},</if>
            <if test="creditLimit != null">credit_limit = #{creditLimit},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where distributor_id = #{distributorId}
    </update>

    <delete id="deleteDistributorById" parameterType="Long">
        delete from pms_distributor where distributor_id = #{distributorId}
    </delete>

    <delete id="deleteDistributorByIds" parameterType="Long">
        delete from pms_distributor where distributor_id in
        <foreach item="distributorId" collection="array" open="(" separator="," close=")">
            #{distributorId}
        </foreach>
    </delete>

</mapper>